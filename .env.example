# Variaveis de ambiente do template
# Copie este arquivo para .env e ajuste os valores

# Servidor
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_SCHEMA=app_db

# JWT (obrigatorio)
JWT_KEY=troque_esta_chave_em_producao

# Owner de inicialização
DEFAULT_TENANT_NAME=DasZK Master
DEFAULT_TENANT_CNPJ=00000000000000
DEFAULT_OWNER_NAME=Admin Master
DEFAULT_OWNER_EMAIL=master@daszk.com
DEFAULT_OWNER_PASSWORD=SenhaSuperForte123!